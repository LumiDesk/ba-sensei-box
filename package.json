{
  "name": "ba-sensei-box",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first Blue Archive Global student roster picker and team-building handoff tool.",
  "type": "module",
  "license": "MIT",
  "author": "Talyra42",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumiDesk/ba-sensei-box.git"
  },
  "homepage": "https://github.com/LumiDesk/ba-sensei-box#readme",
  "bugs": {
    "url": "https://github.com/LumiDesk/ba-sensei-box/issues"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "data:sync": "node scripts/sync-students.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "1.90.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
